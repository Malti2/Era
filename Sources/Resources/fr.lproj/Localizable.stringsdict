			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Dernière sauvegarde il y a %lld jour</string>
			<key>other</key>
			<string>Dernière sauvegarde il y a %lld jours</string>
		</dict>
	</dict>
</dict>
</plist>
